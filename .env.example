# Uygulama tamamen istemci (browser) tarafinda calisir; veriler localStorage'da
# tutulur ve herhangi bir harici API anahtarina ihtiyac yoktur.
#
# Asagidaki degiskenler yalnizca sunucu/Docker calistirma ortamini yapilandirmak icindir.

# Uygulamanin dinleyecegi port (Docker ve `next start` icin)
PORT=3000

# Node calisma ortami
NODE_ENV=production

# --- Giris ekrani (admin oturumu) ---
# Uzun rastgele bir dize uretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ADMIN_PASSWORD_HASH icin:
#   npm run hash-password -- "GucluSifreniz123!"
# ONEMLI: script iki farkli satir basar - bu dosya `.env`/`.env.local` olarak
# doğrudan Next.js tarafindan okunacaksa (yerel gelistirme) KACISLI ("\$...")
# halini kullanin. Production'da systemd EnvironmentFile ile veriliyorsa
# (bkz. README > Live Deployment) HAM (kacissiz) halini kullanin - detay ve
# neden icin scripts/deploy.sh'daki yorumlara bakin.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
