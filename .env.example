# Uygulama tamamen istemci (browser) tarafinda calisir; veriler localStorage'da
# tutulur ve herhangi bir harici API anahtarina ihtiyac yoktur.
#
# Asagidaki degiskenler yalnizca sunucu/Docker calistirma ortamini yapilandirmak icindir.

# Uygulamanin dinleyecegi port (Docker ve `next start` icin)
PORT=3000

# Node calisma ortami
NODE_ENV=production

# --- Giris ekrani (admin oturumu) ---
# Uzun rastgele bir dize uretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ADMIN_PASSWORD_HASH icin:
#   npm run hash-password -- "GucluSifreniz123!"
# ONEMLI: script ciktisindaki her "$" isaretinin onunde "\" olacak sekilde
# kopyalayin (ornek: \$2b\$12\$...). Next.js'in .env okuyucusu "$" isaretini
# kacis karakteri olmadan degisken referansi sanip hash'i sessizce bozar.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
